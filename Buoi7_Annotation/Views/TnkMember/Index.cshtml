@model IEnumerable<Buoi7_Annotation.Models.TnkMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TnkUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TnkPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TnkEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TnkPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TnkUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.TnkPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.TnkEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.TnkPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.TnkId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TnkId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TnkId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
